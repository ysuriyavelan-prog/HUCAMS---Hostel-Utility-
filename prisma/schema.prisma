// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("STUDENT") // ADMIN, STUDENT, TECHNICIAN
  roomId    Int?
  room      Room?    @relation(fields: [roomId], references: [id])
  complaints Complaint[]
  createdAt DateTime @default(now())
}

model Block {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  floors    Int      // Total floors
  rooms     Room[]
}

model Room {
  id        Int      @id @default(autoincrement())
  number    String
  floor     Int
  blockId   Int
  block     Block    @relation(fields: [blockId], references: [id])
  users     User[]
  readings  UtilityReading[]
  alerts    Alert[]
}

model UtilityReading {
  id                Int      @id @default(autoincrement())
  date              DateTime
  roomId            Int
  room              Room     @relation(fields: [roomId], references: [id])
  electricity_kwh   Float
  water_liters      Float
  createdAt         DateTime @default(now())

  @@unique([date, roomId])
}

model Alert {
  id        Int      @id @default(autoincrement())
  type      String   // ELECTRICITY_SPIKE, WATER_LEAKAGE, etc.
  severity  String   // LOW, MEDIUM, HIGH
  status    String   @default("OPEN") // OPEN, RESOLVED
  message   String
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())
}

model Complaint {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  status       String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  studentId    Int
  student      User     @relation(fields: [studentId], references: [id])
  technicianId Int?
  createdAt    DateTime @default(now())
}
